{
  "name": "dart-party",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "worker:types": "wrangler types",
    "worker:check": "tsc --project tsconfig.worker.json",
    "worker:dev": "wrangler dev --local",
    "worker:deploy": "wrangler deploy",
    "worker:test:integration": "node scripts/test-worker-integration.mjs",
    "worker:migrate": "node scripts/migrate-live-data.mjs",
    "worker:verify-migration": "node scripts/verify-migration.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
